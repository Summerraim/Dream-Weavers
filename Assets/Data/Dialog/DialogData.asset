  dialogueId: 1
  dialogueEntries:
  - speakerName: "\u7D22\u62C9"
    dialogueText: "\u554A\uFF0C\u5934\u597D\u6655\uFF0C\u6211\u8FD9\u662F\u5728\u54EA\u91CC\uFF1F"
    portrait: {fileID: 1631304652, guid: a1134eb6c9cb555459dd5ee0f2b5a3eb, type: 3}
    portraitPosition: 0
  - speakerName: "\u7D22\u62C9"
    dialogueText: "\u4F60\u662F\u8C01\u5440\uFF1F\u4E0D\u8981\u5403\u4E86\u6211\u554A\u554A...."
    portrait: {fileID: 1631304652, guid: a1134eb6c9cb555459dd5ee0f2b5a3eb, type: 3}
    portraitPosition: 0
  - speakerName: "\u585E\u52D2\u65AF"
    dialogueText: "\u4F60\u597D\uFF01\u6211\u53EB\u585E\u52D2\u65AF\uFF0C\u662F\u8FD9\u91CC\u7684\u5FC3\u517D\uFF0C\u4F60\u662F\u7B2C\u4E00\u6B21\u8FDB\u5165\u7EC7\u68A6\u4E16\u754C\u5427\u3002"
    portrait: {fileID: 1330059778, guid: 14bbfaacd1a74c64182bddecc8d9faf0, type: 3}
    portraitPosition: 1
  - speakerName: "\u7D22\u62C9"
    dialogueText: "\u662F\u7684\uFF0C\u6211\u521A\u521A\u660E\u660E\u5728807\u5BDD\u5BA4\u73A9\u5B9D\u53EF\u68A6\u5440\uFF0C\u600E\u4E48\u7A81\u7136\u5C31\u51FA\u73B0\u5728\u4E86\u8FD9\u91CC\uFF1F\uFF1F"
    portrait: {fileID: 1631304652, guid: a1134eb6c9cb555459dd5ee0f2b5a3eb, type: 3}
    portraitPosition: 0
  - speakerName: "\u5FB7\u82AC\u65AF"
    dialogueText: "\u603B\u6709\u4E00\u4E9B\u50CF\u4F60\u4E00\u6837\u81EA\u79F0\u4EBA\u7C7B\u7684\u7269\u79CD\u8FDB\u5165\u6211\u4EEC\u7684\u4E16\u754C\uFF0C\u81F3\u4E8E\u4E3A\u4EC0\u4E48\uFF0C\u53EF\u80FD\u5C31\u9700\u8981\u4F60\u81EA\u5DF1\u63A2\u7D22\u4E86\uFF01"
    portrait: {fileID: -559600819, guid: 3170f8c249c67794fb396610b0ce89dc, type: 3}
    portraitPosition: 1
  - speakerName: "\u585E\u52D2\u65AF"
    dialogueText: "\u4E0D\u597D\uFF01\u662F\u88AB\u6C61\u67D3\u7684\u5FC3\u517D\uFF01\u51C6\u5907\u4F5C\u6218\uFF01"
    portrait: {fileID: 1330059778, guid: 14bbfaacd1a74c64182bddecc8d9faf0, type: 3}
    portraitPosition: 1
