  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u662F\u65F6\u5019\u7EC8\u7ED3\u4E00\u5207\u4E86\u3002"
    portrait: {fileID: -1921395299, guid: afd35f25934ce304fa503f6b5b98e17a, type: 3}
    portraitPosition: 1
  - speakerName: "\u7D22\u62C9"
    dialogueText: "\u54FC\uFF0C\u6211\u4EEC\u4E00\u5B9A\u4F1A\u8D62\uFF0C\u963F\u65AF\u8499\u8482\u65AF\u4F60\u662F\u65F6\u5019\u56DE\u5F52\u865A\u7A7A\u4E86\u3002"
