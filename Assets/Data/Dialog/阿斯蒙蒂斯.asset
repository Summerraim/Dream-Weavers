  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u4F46\u662F\u6211\u662F\u4F60\u4EEC\u6C38\u8FDC\u65E0\u6CD5\u7A81\u7834\u7684\u68A6\u9B47\uFF01"
