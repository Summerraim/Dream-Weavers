    portraitPosition: 0
  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u54C8\u54C8\u54C8\u54C8\u54C8\uFF01\u8FD9\u5C31\u662F\u5F3A\u5927\u7684\u7F81\u7ECA\u4E4B\u529B\u5417\uFF0C\u4F20\u95FB\u53EF\u4EE5\u51FB\u8D25\u6076\u9B54\u7684\u529B\u91CF\u5417\uFF1F"
    portrait: {fileID: -1921395299, guid: afd35f25934ce304fa503f6b5b98e17a, type: 3}
    portraitPosition: 1
  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u6240\u7F57\u95E8\u738B\u2026\u2026\u7A76\u7ADF\u8C01\u9519\u4E86\u2026\u2026"
    portrait: {fileID: -1921395299, guid: afd35f25934ce304fa503f6b5b98e17a, type: 3}
    portraitPosition: 1
  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u7D22\u62C9\uFF0C\u5E0C\u671B\u6211\u4EEC\u8FD9\u4E00\u6218\u540E\u8FD8\u6709\u673A\u4F1A\u518D\u89C1\u3002"
    portrait: {fileID: -1921395299, guid: afd35f25934ce304fa503f6b5b98e17a, type: 3}
