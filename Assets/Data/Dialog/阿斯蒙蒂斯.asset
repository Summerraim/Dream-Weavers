  dialogueEntries:
  - speakerName: "\u963F\u65AF\u8499\u8482\u65AF"
    dialogueText: "\u6CA1\u60F3\u5230\u4F60\u8FD8\u662F\u8D70\u5230\u4E86\u8FD9\u91CC\uFF0C\u4F60\u4EEC\u4E0D\u5E94\u8BE5\u6765\u8FD9\u91CC\u7684\u3002"
