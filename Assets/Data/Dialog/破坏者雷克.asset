  - speakerName: "\u7834\u574F\u8005\u96F7\u514B"
    dialogueText: "\u5728\u8FD9\u5EA7\u5931\u4E50\u56ED\u91CC\uFF0C\u6211\u5C06\u7834\u574F\u4E00\u5207\uFF01"
