  - speakerName: "\u7834\u574F\u8005\u96F7\u514B"
    dialogueText: "\u7834\u574F\uFF01\u7834\u574F\uFF01\uFF01"
    portrait: {fileID: 495759148, guid: e656a49b2de7a7d4998053ba90f8995d, type: 3}
